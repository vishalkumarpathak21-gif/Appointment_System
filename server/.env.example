# DocPulse India - Environment Configuration Template
# Copy this file to .env and fill in your credentials

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/docpulse_db?retryWrites=true&w=majority

# Server Port
PORT=5000

# JSON Web Token Secret
JWT_SECRET=docpulse_secure_jwt_secret_key_2026_india

# Nodemailer Email Service (Gmail SMTP for OTP delivery)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Optional: OpenAI API Key for advanced triage
OPENAI_API_KEY=your_api_key_here
